<?xml version="1.0" encoding="UTF-8"?>
<VisioDocument xmlns="http://schemas.microsoft.com/visio/2003/core" xmlns:v="http://schemas.microsoft.com/visio/2003/core">
  <DocumentProperties>
    <Title>CMMC Level 2 Sovereign Enclave System Topology</Title>
    <Subject>EDS-360 Enclave Architecture, STIG Rules, and CUI Boundary</Subject>
    <Company>Emerging Defense Solutions (EDS-360)</Company>
    <Manager>CISO / Security Manager</Manager>
  </DocumentProperties>
  <Pages>
    <Page ID="0" Name="CMMC Enclave Boundary">
      <Shapes>
        <!-- Title Box -->
        <Shape ID="1" Type="Group" NameU="TitleBlock">
          <Text>EDS-360 Sovereign Enclave Boundary &amp; STIG Architecture (CMMC Level 2 / NIST SP 800-171)</Text>
        </Shape>

        <!-- Node 0: Control Plane -->
        <Shape ID="10" Type="Shape" NameU="Node0_ControlPlane">
          <Text>Node 0: Control Plane (10.0.10.128)
Marking: SYS-EDS-360-N0
STIG: DISA RHEL 8/9 High Benchmark
Roles: AI Agents, POAM Generator, SIEM Aggregator</Text>
        </Shape>

        <!-- Node 1: Ingress -->
        <Shape ID="20" Type="Shape" NameU="Node1_Ingress">
          <Text>Node 1: Ingress Proxy (10.0.10.129)
Marking: SYS-EDS-360-N1
STIG: NGINX Web Server STIG / TLS 1.3 FIPS
Roles: Portal Status, Public Ingress, WAF Rules</Text>
        </Shape>

        <!-- Node 2: AI Core -->
        <Shape ID="30" Type="Shape" NameU="Node2_AICore">
          <Text>Node 2: AI Core (10.0.10.130)
Marking: SYS-EDS-360-N2
STIG: Application Server Security STIG
Roles: RBAC Tiers, Auth Engine, Billing Sync</Text>
        </Shape>

        <!-- Node 3: Vault -->
        <Shape ID="40" Type="Shape" NameU="Node3_Vault">
          <Text>Node 3: Vault Storage (10.0.10.131)
Marking: SYS-EDS-360-N3
STIG: DISA OS STIG + AU-2 Audit Baseline
Roles: SIEM AU-2 Vault, BOE Archives, FIPS Keys</Text>
        </Shape>

        <!-- Node 4: Governance -->
        <Shape ID="50" Type="Shape" NameU="Node4_Governance">
          <Text>Node 4: Governance Portal (10.0.10.132)
Marking: SYS-EDS-360-N4
STIG: DISA Database &amp; Audit STIG
Roles: POAM Records, Incident Response, Self-Assessment</Text>
        </Shape>

        <!-- Removable Storage: Apricorn Aegis -->
        <Shape ID="60" Type="Shape" NameU="Apricorn_Storage">
          <Text>Apricorn Aegis Hardware Encrypted Drive
Marking: MEDIA-EDS-CUI-001
Validation: FIPS 140-2/3 Level 3 Hardware Keypad
Access: Physical Attachment to Node 0 Host</Text>
        </Shape>

        <!-- Domain ACL Rules -->
        <Shape ID="70" Type="Group" NameU="Domain_ACLs">
          <Text>Access Control List (ACL) Restriction Zone
Allowed Domain: *.eds-360.com ONLY
Authentication: FIPS ECDSA-384 + Hardware Token (MFA)
External Access: Deny All (Implicit)</Text>
        </Shape>
      </Shapes>
    </Page>
  </Pages>
</VisioDocument>
